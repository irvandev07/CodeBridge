{
  "baseRef": "main",
  "goalFile": "goal.md",
  "evidenceFile": "codebridge.evidence.json",
  "commands": {
    "typecheck": [
      "npm",
      "run",
      "typecheck"
    ],
    "test": [
      "npm",
      "run",
      "test:run"
    ]
  },
  "requiredChecks": [
    "typecheck",
    "test"
  ],
  "failOn": [
    "critical",
    "high"
  ],
  "timeoutMs": 120000,
  "maxConcurrency": 2,
  "strictReview": false,
  "outputDirectory": ".codebridge",
  "rules": {
    "enabled": true,
    "maxChangedFiles": 50,
    "maxAddedLines": 1500,
    "forbiddenPaths": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ],
    "detectCredentials": true,
    "detectPrivateKeys": true,
    "detectDebugStatements": false
  }
}
